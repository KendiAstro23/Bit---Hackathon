PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Africa's Talking sandbox values. USSD webhooks do not require the API key,
# but keeping it here makes deployment config explicit and future-safe.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=replace_me
USSD_SERVICE_CODE=*384#

# Comma-separated relay list. Use at least two relays in production.
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
RELAY_PUBLISH_TIMEOUT_MS=5000

# SQLite database path, relative to this app directory unless absolute.
SQLITE_FILE=./data/minmo-ussd.sqlite

# Implementation assumption: MIP event kinds are configurable until the Minmo
# protocol assigns canonical Nostr kind numbers.
MIP02_KIND=31990
MIP04_KIND=30078
